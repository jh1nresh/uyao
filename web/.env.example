# 複製成 .env.local 再填值。.env.local 已被 gitignore，不會進版控。
#
#   cp web/.env.example web/.env.local
#
# 正式環境不要用檔案，用 `vercel env add <名稱> production`。
# 貼上時如果值被截斷或多出 `[` 開頭的字元，那是終端機的 bracketed paste，
# 改用管道：`printf '值' | vercel env add <名稱> production`。
#
# 注意：`vercel env pull` 對敏感變數會寫成 `[SENSITIVE]` 而不是真值，
# 不要用它來驗證設定對不對 —— 改看 GET /api/line/webhook 的執行期回報。

# ── LINE Messaging API（藥局端通知）──────────────────────────
# LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 你自己的 LINE userId（U + 32 個小寫十六進位字元），逗號分隔。
# 只有名單內的人講「核准 B-42」才會開通藥局綁定。
LINE_ADMIN_USER_IDS=

# 舊版的靜態綁定，KV 上線後已不需要。留著只是為了不讓既有綁定斷線。
# LINE_STORE_BINDINGS={"Uxxxx":"惠民藥局"}

# ── LINE Login（消費者端，尚未實作）─────────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ── KV（Vercel Storage → Upstash Redis 會自動注入）──────────
# 預留、取貨頁、綁定、放鳥計數都靠它。沒有的話取貨頁會顯示「查不到」。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cron（催單與逾期掃描）───────────────────────────────────
# 沒設的話線上會直接拒絕執行 —— x-vercel-cron 標頭可以偽造，不能當憑證。
#   openssl rand -hex 32 | vercel env add CRON_SECRET production
CRON_SECRET=

# ── 表單與需求訊號的額外出口（選配）─────────────────────────
# 任何吃 JSON POST 的端點（Slack / Discord / n8n）。
# 有 KV 之後不設也不會掉資料，設了只是多一個會跳通知的地方。
# RECORD_WEBHOOK_URL=
# PILOT_WEBHOOK_URL=
