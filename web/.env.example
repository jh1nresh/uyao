# 複製成 .env.local 再填值。.env.local 已被 gitignore，不會進版控。
#
#   cp web/.env.example web/.env.local
#
# 正式環境不要用檔案，用 `vercel env add <名稱> production`（值由你在終端機
# 輸入，不會出現在指令歷史裡）。

# ── LINE Messaging API（藥局端通知）─────────────────────────
# 從 LINE Developers Console → 你的 Messaging API channel 取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── LINE Login（消費者端，之後才需要）───────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ── 地圖圖磚（已移除地圖，保留給未來換供應商用）─────────────
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=
