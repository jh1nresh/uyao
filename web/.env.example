# 複製成 .env.local 再填值。.env.local 已被 gitignore，不會進版控。
#
#   cp web/.env.example web/.env.local
#
# 正式環境不要用檔案，用 `vercel env add <名稱> production`。
# 貼上時如果值被截斷或多出 `[` 開頭的字元，那是終端機的 bracketed paste，
# 改用管道：`printf '值' | vercel env add <名稱> production`。
#
# 注意：`vercel env pull` 對敏感變數會寫成 `[SENSITIVE]` 而不是真值，
# 不要用它來驗證設定對不對；以 Store OS 設定頁和執行期 log 為準。

# ── KV（Vercel Storage → Upstash Redis 會自動注入）──────────
# 預留、取貨頁、Web Push 訂閱、放鳥計數都靠它。沒有的話取貨頁會顯示「查不到」。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Store OS 店家登入與 tenant database ──────────────────────
# 標準 PostgreSQL connection URL。先執行 db/migrations/001_store_identity.sql。
DATABASE_URL=
# session 簽章密鑰，至少 32 字元。production 請用隨機值：
#   openssl rand -hex 32 | vercel env add STORE_OS_SESSION_SECRET production
STORE_OS_SESSION_SECRET=
# uYao ops 建立一次性店家邀請的 API secret，至少 32 字元。
STORE_OS_ADMIN_SECRET=
# 邀請連結的公開根網址；production 可省略，預設如下。
STORE_OS_PUBLIC_URL=https://store.uyaohealth.com/

# ── Store OS PWA / Web Push ───────────────────────────────────
# 產生一次 VAPID key pair：npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# mailto: 或 https: 聯絡識別；不得填金鑰。
WEB_PUSH_SUBJECT=mailto:support@uyaohealth.com

# ── Cron（催單與逾期掃描）───────────────────────────────────
# 沒設的話線上會直接拒絕執行 —— x-vercel-cron 標頭可以偽造，不能當憑證。
#   openssl rand -hex 32 | vercel env add CRON_SECRET production
CRON_SECRET=

# ── 表單與需求訊號的額外出口（選配）─────────────────────────
# 任何吃 JSON POST 的端點（Slack / Discord / n8n）。
# 有 KV 之後不設也不會掉資料，設了只是多一個會跳通知的地方。
# RECORD_WEBHOOK_URL=
# PILOT_WEBHOOK_URL=

# ── 盒子掃描流（模擬與正式共用）───────────────────────────
# 盒子/模擬器上傳的通行證。production 沒設會拒收所有上傳（fail closed）。
#   openssl rand -hex 32 | vercel env add BOX_API_KEY production
BOX_API_KEY=
# /console 的鑰匙。設了之後要開 /console?key=<值> 才看得到 —— 流水裡有
# 真單的取貨碼與店名。沒設就開放（本機、純示範）。
CONSOLE_KEY=
# device_id → 藥局 slug 的正式對應（JSON）。模擬時不用設：
# device_id 直接傳藥局 slug 就通。
# BOX_DEVICE_BINDINGS={"box-001":"OK藥師藥局"}
